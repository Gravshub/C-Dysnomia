# ═══════════════════════════════════════════════════════════════════════
#  |>JOYSTICK<| Environment Configuration
#  File: .env.pulse
#
#  This is the ONLY file that holds your private key.
#  NEVER commit this file to git. NEVER share it.
#  The .gitignore already excludes it.
#
#  Usage: set -a && source .env.pulse && set +a
#  (This exports every variable so Python's os.getenv() can read them)
# ═══════════════════════════════════════════════════════════════════════

# ─── WALLET (REQUIRED — the bot cannot run without this) ─────────────
# Your Joey wallet private key. No 0x prefix.
# Example: abc123def456...  (64 hex characters)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# ─── CHAIN ───────────────────────────────────────────────────────────
CHAIN_ID=369

# ─── RPC ENDPOINTS ───────────────────────────────────────────────────
# Dual-RPC pattern: separate reads from TX submission
# g4mm4 = faster for reads (Multicall3 batches)
# pulsechain.com = reliable for TX propagation
RPC_URL_READ=https://rpc-pulsechain.g4mm4.io
RPC_URL=https://rpc.pulsechain.com

# ─── CONTRACT ADDRESSES ─────────────────────────────────────────────
TGSV8_ADDRESS=0xAD352a27ceaaC5657e3E9127f964F4746A8aAc32
JV8A_ADDRESS=0x364793Ea48DEe0b5484F98235ABd1B5f996A0C30
DSS_ADDRESS=0x91Df693177eE5C81016d0B7c4c2052A7d229c031
GIBS_LAU=0x66a08aa12da955eb63d7ac121a88b2b210a07b03

# Legacy — do not use for new engines
TGSV7_ADDRESS=0x82E8B7e24bD9f0b389e94ddB8714B001a58e387d
TGSV5_ADDRESS=0xeeB330d3419193b4E42507fA07CcF2fC681a6127

# ─── GAS SETTINGS ────────────────────────────────────────────────────
# Gas ceiling in Beats. If gas price exceeds this, the bot skips the cycle.
# PulseChain typical: 5-30 Beats. Spikes can hit 100K+ during congestion.
# 50 Beats is conservative — adjust based on your experience.
GAS_CEILING_BEATS=50

# Gas multiplier for estimate_gas(). 1.3 = 30% buffer above estimate.
# Never send a TX without this buffer — if estimate fails, TX is skipped.
GAS_MULTIPLIER=1.3

# ─── BOT SETTINGS ───────────────────────────────────────────────────
# Cycle delay in seconds between engine runs
BOT_CYCLE_DELAY=30

# Minimum PLS balance to maintain. Bot pauses if balance drops below this.
GAS_BUFFER_FLOOR=100000

# ─── DASHBOARD API (optional — only needed if running the dashboard) ─
API_PORT=8369
API_HOST=0.0.0.0
BOT_DATA_DIR=/opt/joystick/data

# ─── LOGGING ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=/opt/joystick/logs/joystick.log
